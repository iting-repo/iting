# ==========================================
# ITing Production Environment Configuration
# ==========================================
# Copy this file to .env on EC2 (/opt/iting/.env)
# Fill in all CHANGE_ME values before deployment.
# NEVER commit this file to Git.

# ========================================
# Domain Configuration
# ========================================
DOMAIN=datnhk252iting.dpdns.org
API_DOMAIN=api.datnhk252iting.dpdns.org
MONITOR_DOMAIN=monitor.datnhk252iting.dpdns.org
VITE_API_BASE=https://api.datnhk252iting.dpdns.org/api
CORS_ORIGINS=https://datnhk252iting.dpdns.org,https://www.datnhk252iting.dpdns.org

# ========================================
# Deployment Environment
# ========================================
DEPLOY_ENV=prod
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_ORG/iting-backend:latest
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_ORG/iting-frontend:latest

# ========================================
# Database (RDS PostgreSQL)
# ========================================
DB_HOST=jobweb.cbkcwwk8ug43.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=iting_job_portal
DB_USERNAME=iting_app
DB_PASSWORD=CHANGE_ME
DB_SCHEMA=public

# ========================================
# JWT Authentication
# ========================================
JWT_SECRET=CHANGE_ME_32_CHAR_HEX_STRING
JWT_EXPIRATION=86400000
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX_STRING
JWT_REFRESH_EXPIRATION=604800000

# ========================================
# Redis
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ========================================
# Kafka
# ========================================
KAFKA_BROKERS=kafka:29092

# ========================================
# AWS S3
# ========================================
AWS_ACCESS_KEY=CHANGE_ME
AWS_SECRET_KEY=CHANGE_ME
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=datn-jobweb
AWS_ENABLED=true

# ========================================
# Email (SMTP)
# ========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME@gmail.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD

# ========================================
# Google OAuth
# ========================================
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ========================================
# AI (optional)
# ========================================
# Gemini 2.5 Flash — dùng cho CV scoring + CV parsing. Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
GEMINI_API_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ========================================
# Grafana
# ========================================
GF_ADMIN_PASSWORD=CHANGE_ME

# ========================================
# Portainer
# ========================================
PORTAINER_PASSWORD=CHANGE_ME

# ========================================
# Discord Webhook
# ========================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME

# ========================================
# Application Settings
# ========================================
SPRING_PROFILES_ACTIVE=prod
APP_ENV=production
SERVER_PORT=8080
SERVER_SHUTDOWN=graceful
SWAGGER_ENABLED=false
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ITING=INFO
