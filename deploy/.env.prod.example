# ==========================================
# Production-only environment overrides
# ==========================================
# File này KHÔNG commit secrets. Secrets thực được inject tự động bởi
# GitHub Actions deploy.yml từ repo secrets (xem README bên dưới).
#
# File này tồn tại trên EC2 tại /opt/iting/.env.prod, có quyền 600 (chỉ owner).
# docker-compose load file này SAU /opt/iting/.env, dùng để override
# những giá trị prod-specific (DB host, API key, ...).
#
# ==========================================
# GitHub Secrets cần set
# ==========================================
#   - GEMINI_API_KEY    (bắt buộc) Google AI Studio API key
#   - GEMINI_API_URL    (optional) Override URL endpoint
#   - GEMINI_API_MODEL  (optional) Override model name
#
# Cấu hình tại: https://github.com/iting-repo/iting/settings/secrets/actions
# Lấy API key tại: https://aistudio.google.com/apikey

# ---- Google Gemini AI (required) ----
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
GEMINI_API_MODEL=gemini-2.5-flash

# ---- Production-only DB override (if separate from .env) ----
# DB_HOST=postgres-prod
# DB_PORT=5432
# DB_NAME=iting_job_portal_prod
# DB_USER=iting_app
# DB_PASSWORD=

# ---- Production-only Redis override ----
# REDIS_HOST=redis-prod
# REDIS_PORT=6379
# REDIS_PASSWORD=
