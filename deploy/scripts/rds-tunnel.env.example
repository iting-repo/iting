# Copy to rds-tunnel.env (gitignored) and adjust paths:
#   copy rds-tunnel.env.example rds-tunnel.env
#
# Run from repo root or deploy/:
#   powershell -ExecutionPolicy Bypass -File deploy/scripts/docker-compose-with-rds-tunnel.ps1 up
#   powershell -ExecutionPolicy Bypass -File deploy/scripts/docker-compose-with-rds-tunnel.ps1 build
#
# Requires .env.local with DB_HOST=host.docker.internal and DB_PORT matching ITING_LOCAL_TUNNEL_PORT.

ITING_SSH_KEY=C:\path\to\iting-key-pair.pem
ITING_SSH_USER=ubuntu
ITING_BASTION_HOST=18.136.8.143
ITING_RDS_PRIVATE_IP=10.0.2.187
ITING_RDS_PORT=5432
ITING_LOCAL_TUNNEL_PORT=15432
