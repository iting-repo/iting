# Local environment for docker compose override
DEPLOY_ENV=dev

# Build and runtime images (local tags)
BACKEND_IMAGE=iting-backend:local
FRONTEND_IMAGE=iting-frontend:local

# Domains / frontend API
DOMAIN=localhost
API_DOMAIN=localhost
MONITOR_DOMAIN=localhost
VITE_API_BASE=http://localhost:8081
CORS_ORIGINS=http://localhost:3000,http://localhost

# Database
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=iting_job_portal
DB_USERNAME=postgres
DB_PASSWORD=250904
DB_SCHEMA=public

# JWT
JWT_SECRET=CHANGE_ME_LOCAL
JWT_EXPIRATION=86400000
JWT_REFRESH_SECRET=CHANGE_ME_LOCAL
JWT_REFRESH_EXPIRATION=604800000

# Redis/Kafka
REDIS_PASSWORD=CHANGE_ME_LOCAL
KAFKA_BROKERS=kafka:29092

# AWS S3 (optional for local)
AWS_ENABLED=true
AWS_ACCESS_KEY=CHANGE_ME
AWS_SECRET_KEY=CHANGE_ME
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=datn-jobweb

# Mail / OAuth
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# AI
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ops
GF_ADMIN_PASSWORD=admin
PORTAINER_PASSWORD=admin
DISCORD_WEBHOOK_URL=
SPRING_PROFILES_ACTIVE=dev
APP_ENV=development
SERVER_PORT=8080
SERVER_SHUTDOWN=graceful
SWAGGER_ENABLED=true
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ITING=DEBUG
