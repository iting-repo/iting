# Copy to .env.local and fill in values (never commit .env.local):
#   copy .env.local.example .env.local
#
# --- RDS từ máy Windows (Security Group) ---
# 1) RDS → Connectivity & security: ghi Endpoint + Port (thường 5432), mở VPC security group.
# 2) EC2 → Security Groups → Inbound rules → Add: Type PostgreSQL, Port 5432, Source "My IP" (/32).
# 3) RDS private (Publicly accessible = No): cần VPN/Bastion/SSM tunnel — không chỉ mở SG cho IP nhà.
# 4) Kiểm tra trước khi chạy backend:
#      Test-NetConnection -ComputerName <DB_HOST> -Port 5432
#    TcpTestSucceeded = True rồi thử psql/DBeaver với cùng user/db như DB_* ở trên.
#
# Compose: từ thư mục deploy/
#   docker compose -f docker-compose.local.yml --env-file .env.local build
#   docker compose -f docker-compose.local.yml --env-file .env.local up
#
# RDS private + tunnel qua EC2 (Windows): copy scripts/rds-tunnel.env.example → scripts/rds-tunnel.env,
# đặt ITING_SSH_KEY (đường dẫn tuyệt đối tới .pem). Trong .env.local dùng:
#   DB_HOST=host.docker.internal
#   DB_PORT=<cùng ITING_LOCAL_TUNNEL_PORT, mặc định 15432>
# Chạy một lệnh (tunnel tự bật/tắt):
#   powershell -ExecutionPolicy Bypass -File deploy/scripts/docker-compose-with-rds-tunnel.ps1 up -d

# ---- RDS (Spring prod profile: DB_USERNAME / DB_PASSWORD) ----
DB_HOST=your-rds.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=your_database
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ---- Redis (container redis trong compose; mật khẩu tự chọn cho local) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-local

# ---- JWT (dùng secret đủ dài; có thể copy từ môi trường dev an toàn) ----
JWT_SECRET=change-me-min-256-bits-hex-or-random-string
JWT_EXPIRATION=86400000
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION=604800000

# ---- CORS (frontend local trên cổng 3000) ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Build arg cho frontend (browser gọi API trên host)
VITE_API_BASE=http://localhost:8081

# ---- OpenTelemetry (tắt khi local; compose cũng set OTEL_JAVAAGENT_ENABLED=false) ----
OTEL_JAVAAGENT_ENABLED=false

# ---- Tuỳ chọn: S3, OAuth, mail, AI (điền nếu tính năng cần khi test) ----
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=
# AWS_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# GEMINI_API_KEY=
# SWAGGER_ENABLED=true
