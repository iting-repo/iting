@startuml
actor HR
participant FE
participant JobSvc
participant NotifSvc
database DB


HR -> FE : Tạo/Chỉnh sửa/Gia hạn/Đóng/Xóa tin
alt Tạo mới
FE -> JobSvc : createJob(companyId, payload)
JobSvc -> DB : INSERT job(status="open")
DB --> JobSvc : ok
JobSvc --> FE : success
else Chỉnh sửa/Gia hạn
FE -> JobSvc : updateJob(jobId, changes)
JobSvc -> DB : UPDATE job ...
DB --> JobSvc : ok
JobSvc --> FE : success
else Đóng/Xóa
FE -> JobSvc : closeOrDelete(jobId)
JobSvc -> DB : UPDATE status or DELETE
DB --> JobSvc : ok
JobSvc --> FE : success
end
opt Gửi thông báo tới người theo dõi tin
JobSvc -> NotifSvc : broadcast(jobId, followers)
NotifSvc --> JobSvc : ack
end
@enduml