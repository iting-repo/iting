@startuml
actor Candidate
participant FE
participant JobSvc
participant ApplicantSvc
participant NotifSvc
database DB

Candidate -> FE : Click "Ứng tuyển ngay"
FE -> JobSvc : checkEligibility(userId,jobId)                  ' sync
JobSvc -> DB : getJob + deadline/status                        ' sync
DB --> JobSvc : job                                            ' reply

alt hồ sơ đủ & job mở
  FE -> ApplicantSvc : submitApplication(userId,jobId,cvUrl,info)  ' sync
  ApplicantSvc -> DB : INSERT application(status="submitted")       ' sync
  DB --> ApplicantSvc : ok
  ApplicantSvc ->> NotifSvc : notify(HR, "Có ứng viên ứng tuyển")   ' ASYNC
  ApplicantSvc --> FE : success                                    ' reply
else thiếu hồ sơ / job đóng
  JobSvc --> FE : error("Hồ sơ thiếu" / "Tin đã đóng")             ' reply (thay cho return)
end
@enduml
