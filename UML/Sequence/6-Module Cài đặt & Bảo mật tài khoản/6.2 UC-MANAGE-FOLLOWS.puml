@startuml
actor Candidate
participant FE
participant CompanySvc
database DB


Candidate -> FE : Vào "Công ty đang theo dõi"
FE -> CompanySvc : listFollows(userId)
CompanySvc -> DB : SELECT follows
DB --> CompanySvc : rows
CompanySvc --> FE : list
Candidate -> FE : Bỏ theo dõi
FE -> CompanySvc : unfollow(userId, companyId)
CompanySvc -> DB : DELETE follow
DB --> CompanySvc : ok
CompanySvc --> FE : success
@enduml