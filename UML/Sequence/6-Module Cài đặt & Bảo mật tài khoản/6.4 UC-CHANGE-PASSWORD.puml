@startuml
actor Candidate as User
participant FE
participant AuthSvc
participant EmailOTP
database DB


User -> FE : Cài đặt -> Đổi mật khẩu
FE -> AuthSvc : requestChange(userId, oldPw, newPw)
AuthSvc -> AuthSvc : verifyOldPassword
alt đúng mật khẩu cũ
AuthSvc -> EmailOTP : createOTP(userEmail)
EmailOTP --> AuthSvc : token
AuthSvc --> FE : showOTP
User -> FE : Nhập OTP
FE -> AuthSvc : confirmChange(userId, otp, newPw)
AuthSvc -> EmailOTP : verifyOTP(userEmail, otp)
alt OTP hợp lệ & newPw mạnh
AuthSvc -> DB : update password hash
DB --> AuthSvc : ok
AuthSvc --> FE : success
else OTP sai/yếu mật khẩu mới
AuthSvc --> FE : error
end
else sai mật khẩu cũ
AuthSvc --> FE : error("Mật khẩu hiện tại không chính xác")
end
@enduml