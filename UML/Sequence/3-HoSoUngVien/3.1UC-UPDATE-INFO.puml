@startuml
title Cập nhật thông tin cá nhân (Update Profile)

skinparam sequence {
  ArrowColor black
  ParticipantBorderColor #4B5563
  ParticipantBackgroundColor #EEF2FF
  ActorBorderColor #4B5563
  ActorBackgroundColor #E0E7FF
  LifeLineColor #94A3B8
  AltBackgroundColor #F3F4F6
  BoxLineColor #CBD5E1
}

actor Candidate
participant FE
participant ProfileSvc
database DB

Candidate -> FE : Mở Hồ sơ cá nhân → Sửa → Lưu
FE -> ProfileSvc : updateInfo(userId, profile)
ProfileSvc -> ProfileSvc : validate(profile)

alt hợp lệ
  ProfileSvc -> DB : updateProfile(userId, profile)
  DB --> ProfileSvc : ok
  ProfileSvc --> FE : success
  FE --> Candidate : "Cập nhật thành công"
else không hợp lệ
  ProfileSvc --> FE : error(fields)
end
@enduml
