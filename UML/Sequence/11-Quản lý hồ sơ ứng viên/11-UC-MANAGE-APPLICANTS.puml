@startuml
actor HR
participant FE
participant ApplicantSvc
participant NotifSvc
database DB


HR -> FE : Mở "Quản lý hồ sơ ứng viên"
FE -> ApplicantSvc : search(filter)
ApplicantSvc -> DB : SELECT applications JOIN users
DB --> ApplicantSvc : rows
ApplicantSvc --> FE : list
HR -> FE : Xem chi tiết hồ sơ
FE -> ApplicantSvc : getDetail(appId)
ApplicantSvc -> DB : SELECT app + CV URL
DB --> ApplicantSvc : data
ApplicantSvc --> FE : detail
opt Thêm ghi chú
HR -> FE : Lưu ghi chú
FE -> ApplicantSvc : addNote(appId, note)
ApplicantSvc -> DB : INSERT note
DB --> ApplicantSvc : ok
ApplicantSvc --> FE : success
end
opt Duyệt/Từ chối
HR -> FE : Update status(appId, APPROVED/REJECTED)
FE -> ApplicantSvc : setStatus(appId, status)
ApplicantSvc -> DB : UPDATE application.status
DB --> ApplicantSvc : ok
ApplicantSvc -> NotifSvc : notify(Candidate, statusChange)
NotifSvc --> ApplicantSvc : ack
end
@enduml