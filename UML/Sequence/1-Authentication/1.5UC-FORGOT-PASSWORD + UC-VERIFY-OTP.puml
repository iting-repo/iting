@startuml
actor Guest
participant FE
participant AuthSvc
participant EmailOTP
database DB

Guest -> FE : Click "Quên mật khẩu" -> Nhập email
FE -> AuthSvc : requestReset(email)                     ' sync
AuthSvc -> DB : findUser(email)                         ' sync
DB --> AuthSvc : user?/null                             ' reply

alt user tồn tại
  AuthSvc ->> EmailOTP : createResetOTP(email)          ' ASYNC gửi OTP
  EmailOTP --> AuthSvc : token                          ' reply
  AuthSvc --> FE : showOTPForm                          ' reply

  Guest -> FE : Nhập OTP + NewPassword
  FE -> AuthSvc : resetPassword(email,otp,newPw)        ' sync
  AuthSvc -> EmailOTP : verifyOTP(email,otp)            ' sync
  alt OTP hợp lệ
    AuthSvc -> DB : update password hash                ' sync
    DB --> AuthSvc : ok                                 ' reply
    AuthSvc --> FE : success                            ' reply
  else OTP sai/hết hạn
    AuthSvc --> FE : error("OTP invalid/expired")       ' reply
  end

else user không tồn tại
  ' Trả lời chung để không lộ thông tin tài khoản
  AuthSvc --> FE : success("Nếu email tồn tại, hướng dẫn đã được gửi")
end
@enduml
