@startuml
title ACT-VIEW-APPLIED + TRACK (Detailed — lanes: User, UI, Applicant)

|User|
start
:Open trang "Việc làm đã ứng tuyển";

|UI|
:Kiểm tra session đăng nhập;
if (Đã đăng nhập?) then (Yes)
else (No)
  :Chuyển sang trang Đăng nhập;
  stop
endif

:Khởi tạo bộ lọc & phân trang mặc định\n(status=all, sort=desc, page=1, size=20);
:Hiển thị skeleton list;

|Applicant|
:Query danh sách ứng tuyển\n(userId, filters, page);
if (Lỗi hệ thống?) then (Yes)
  |UI|
  :Hiển thị lỗi "Không thể tải dữ liệu";
  stop
endif

|UI|
:Nhận danh sách ứng tuyển (apps, total, hasNext?);
if (Danh sách rỗng?) then (Yes)
  :Hiển thị trạng thái rỗng\n("Bạn chưa ứng tuyển công việc nào");
  :Hiển thị nút "Tìm việc ngay";
  stop
else (No)
  :Render danh sách bản ghi (tên job, công ty, ngày nộp...);
endif

'--- Tải trạng thái hiện tại cho từng hồ sơ
|UI|
:Vòng lặp từng hồ sơ trong danh sách;

|Applicant|
:Tra cứu trạng thái hiện tại cho appId\n(Đã nộp/Đang xem xét/Mời phỏng vấn/Trúng tuyển/Từ chối);
:Trả về trạng thái + mốc thời gian;

|UI|
:Cập nhật trạng thái trên từng item\n(kèm màu/nhãn/badge);

'--- Tương tác bổ sung
if (Người dùng thay đổi bộ lọc/sắp xếp?) then (Có)
  |UI|
  :Cập nhật filters & page=1;
  :Quay lại bước Query danh sách;   ' về luồng trên
endif

if (Người dùng bấm "Xem chi tiết"?) then (Có)
  |UI|
  :Đi tới trang chi tiết ứng tuyển\n(hoặc chi tiết job);
endif

if (Có trang sau?) then (Có)
  |UI|
  :Bấm "Tải thêm" / infinite scroll;
  |Applicant|
  :Query trang kế tiếp (page+1);
  |UI|
  :Append danh sách + cập nhật trạng thái như trên;
endif

stop
@enduml
