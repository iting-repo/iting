@startuml
title ACT-APPLY-JOB (Revised - Based on CandidateApplicationService)

skinparam activity {
  BackgroundColor #ffffff
  DiamondBackgroundColor #EEF2FF
  StartColor #10B981
  EndColor #EF4444
  ArrowColor #6366F1
}

|Candidate (User)|
start
:Xem chi tiết công việc;
:Nhấn nút "Ứng tuyển ngay";

|Frontend (UI)|
if (Đã đăng nhập Candidate?) then (No)
  :Yêu cầu đăng nhập;
  stop
else (Yes)
  :Hiển thị Modal ứng tuyển;
  :Chọn CV (từ danh sách đã có);
  :Nhập thư giới thiệu (Cover Letter);
  :Gửi yêu cầu POST /api/candidates/applications/apply;
endif

|Backend (API/Service)|
:Xác thực userId & Valid request;

if (Đã ứng tuyển trước đó?) then (Yes)
  |Frontend (UI)|
  :Hiển thị lỗi "Bạn đã ứng tuyển job này";
  stop
else (No)
  |Backend (API/Service)|
  :Kiểm tra Job tồn tại & ACTIVE;
  :Lấy thông tin CV theo cvId;
  
  partition "Database Transaction" {
    :Tạo bản ghi **ApplyForm**\n(Thông tin ứng viên + CV + Thư giới thiệu);
    :Lưu vào DB;
    :Tạo liên kết **ApplyFormSentToJob**;
    :Tăng số lượng ứng tuyển (**applicationCount**) tại Job;
  }
  
  :InteractionService.trackInteraction()\n(Ghi nhận hành động APPLY cho Recommender);

  |Frontend (UI)|
  :Hiển thị "Ứng tuyển thành công!";
  :Cập nhật trạng thái nút Ứng tuyển sang "Đã ứng tuyển";
endif

stop
@enduml
