@startuml
title ACT-ADMIN-REVIEW-JOB (Administrative Vetting)

skinparam activity {
  BackgroundColor #ffffff
  DiamondBackgroundColor #EEF2FF
  StartColor #10B981
  EndColor #EF4444
  ArrowColor #6366F1
}

|Admin|
start
:Truy cập Bảng điều khiển Admin;
:Vào mục "Duyệt tin tuyển dụng";

|Frontend (UI)|
:Lấy danh sách PENDING (GET /api/admin/jobs/filter?status=PENDING);

|Admin|
:Chọn một tin để kiểm tra;

|Frontend (UI)|
:Hiển thị chi tiết Job nội bộ (GET /api/admin/jobs/{id});

|Admin|
if (Sử dụng hỗ trợ?) then (AI Review)
  |Backend (AdminJobService)|
  :Gọi chức năng AI Review;
  :Analyze nội dung (ngôn từ, độ tin cậy, format);
  :Trả về điểm số & cảnh báo (nếu có);
  |Frontend (UI)|
  :Hiển thị kết quả AI đánh giá;
else (Manual)
endif

|Admin|
if (Quyết định?) then (Approve)
  |Frontend (UI)|
  :Gửi yêu cầu POST /{id}/approve;
  |Backend (AdminJobService)|
  :Chuyển status -> **ACTIVE**;
  :Gửi thông báo thành công cho Employer;
elseif (Reject)
  |Admin|
  :Nhập lý do từ chối (ReviewRejectRequest);
  |Frontend (UI)|
  :Gửi yêu cầu POST /{id}/reject;
  |Backend (AdminJobService)|
  :Chuyển status -> **REJECTED**;
  :Lưu lý do rejection;
  :Thông báo lỗi cho Employer chỉnh sửa;
endif

|Frontend (UI)|
:Xác nhận hoàn tất xử lý;
:Tải lại danh sách PENDING;

stop
@enduml
