@startuml
title ACT-FORGOT-PASSWORD (Detailed — lanes: User, UI, Auth, Mail)

|User|
start
:Open "Quên mật khẩu";

|UI|
:Nhập email;
:Validate định dạng email (client);
if (Định dạng hợp lệ?) then (Yes)
else (No)
  :Hiển thị lỗi "Email không hợp lệ";
  stop
endif

|Auth|
:Chuẩn hóa email;
:Kiểm tra rate-limit theo email/IP;
if (Quá giới hạn?) then (Yes)
  |UI|
  :Thông báo "Thử lại sau ít phút";
  stop
endif

:Tra cứu tài khoản theo email;
if (Tài khoản tồn tại?) then (Yes)
  :Tạo OTP reset + TTL;
  :Lưu OTP (hash), TTL, attempt=0, resendAt;

  |Mail|
  :Gửi email chứa mã/đường dẫn đặt lại;

  |UI|
  :Hiển thị form nhập OTP + mật khẩu mới + xác nhận;
  :Hiển thị đồng hồ đếm cho "Gửi lại mã";

  |User|
  :Nhập OTP + mật khẩu mới;

  |UI|
  :Kiểm tra độ mạnh & khớp mật khẩu;
  if (Mật khẩu hợp lệ?) then (Yes)
  else (No)
    :Báo lỗi theo trường;
    stop
  endif

  |Auth|
  :Tăng attempt của OTP;
  if (Vượt số lần cho phép?) then (Yes)
    |UI|
    :OTP bị khóa — yêu cầu mã mới;
    stop
  endif

  :Xác thực OTP còn hạn & khớp;
  if (OTP hợp lệ?) then (Yes)
    :Cập nhật mật khẩu (hash);
    :Vô hiệu hóa OTP & session cũ;
    |UI|
    :Đổi mật khẩu thành công → Đăng nhập lại;
    stop
  else (No)
    |UI|
    :OTP sai/hết hạn;
    stop
  endif

else (No)
  |UI|
  :Nếu email tồn tại, hướng dẫn đã được gửi;
  stop
endif
@enduml
