@startuml
title ACT-GUEST-SEARCH-FILTER-VIEW (Public Job Discovery Flow)

skinparam activity {
  BackgroundColor #ffffff
  DiamondBackgroundColor #EEF2FF
  StartColor #10B981
  EndColor #EF4444
  ArrowColor #6366F1
}

|Guest|
start
:Nhập từ khóa (vị trí, tên công việc...);
:Nhấn nút tìm kiếm;

|Frontend (FE)|
:Chuyển hướng sang trang **Search Jobs**;
:Trích xuất params từ URL;
:Gửi yêu cầu GET /api/jobs/search\n(keyword, location, status=ACTIVE);

|Backend (BE)|
:JobService.searchJobs();
:Truy vấn Database (Job + Company);
:Trả về danh sách JobResponse (Page);

|Frontend (FE)|
:Render danh sách Job Cards;

|Guest|
if (Sử dụng bộ lọc nâng cao?) then (Có)
  :Chọn tiêu chí (Lương, Cấp bậc, Loại hình...);
  |Frontend (FE)|
  :Cập nhật các params (\n jobTypes, experienceLevels, minSalary...);
  :Gửi lại yêu cầu GET /api/jobs/search\nvới các bộ lọc mới;
  |Backend (BE)|
  :Xử lý filter query linh hoạt;
  :Trả về kết quả đã lọc;
  |Frontend (FE)|
  :Render lại danh sách kết quả;
else (Không)
endif

|Guest|
:Click vào một Job Card cụ thể;

|Frontend (FE)|
:Điều hướng sang trang **Job Detail**;
:Gửi yêu cầu GET /api/jobs/{id};

|Backend (BE)|
:Kiểm tra tồn tại & trạng thái Job;
:Enrich dữ liệu Company (logo, name...);
:Trả về chi tiết JobResponse;

|Frontend (FE)|
:Hiển thị chi tiết công việc,\nmô tả, yêu cầu và thông tin công ty;

|Guest|
:Xem nội dung tuyển dụng;

stop
@enduml
