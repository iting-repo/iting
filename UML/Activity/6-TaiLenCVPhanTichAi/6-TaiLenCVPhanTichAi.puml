@startuml
title ACT-UPLOAD-CV + AI (Detailed — lanes: User, UI, CDN, Profile, Queue, AI)

|User|
start
:Mở trang Hồ sơ -> Chọn "Tải lên CV";
:Chọn file từ máy (PDF/DOC/DOCX);

|UI|
:Kiểm tra định dạng & dung lượng (client);
if (Hợp lệ?) then (Yes)
else (No)
  :Hiển thị lỗi "Định dạng/Dung lượng không hợp lệ";
  stop
endif

:Hiển thị tiến trình upload;

|CDN|
:Nhận upload từ UI (PUT/POST);
if (Upload thành công?) then (Yes)
  |UI|
  :Nhận URL file (cvUrl) + metadata (size, mime, tên file);
else (No)
  |UI|
  :Báo "Tải lên thất bại, thử lại";
  stop
endif

|Profile|
:attachCV(userId, cvUrl, metadata);
:Validate server (đuôi file, kích thước, virus-scan nếu có);
if (Server validate OK?) then (Yes)
else (No)
  |UI|
  :Báo lỗi "CV không hợp lệ trên máy chủ";
  stop
endif

:Thay thế CV cũ? (nếu có) -> cập nhật DB;
:Đặt trạng thái CV = "processing";
:Khởi tạo jobId cho AnalyzeCV;

|Queue|
:Enqueue job AnalyzeCV (userId, cvUrl, jobId, priority);

|UI|
:Hiển thị "Tải lên thành công — Đang phân tích CV";
:Hiển thị nút "Làm mới" hoặc auto-poll trạng thái;

|AI|
:Worker nhận job AnalyzeCV;
:Tải file từ CDN;
:Trích xuất text (PDF/DOC/DOCX);
:Phân tích phần mục (kinh nghiệm/kỹ năng/học vấn/thông tin liên hệ);
:Chuẩn hóa kết quả (JSON fields, dedup kỹ năng);
if (Phân tích thành công?) then (Yes)
  |Profile|
  :Lưu dữ liệu phân tích vào hồ sơ (upsert skills/exp/edu);
  :Tính %độ hoàn thiện hồ sơ;
  :Cập nhật trạng thái CV = "completed";
  :Ghi audit log (userId, jobId, thời gian);
else (No)
  |Profile|
  :Cập nhật trạng thái CV = "failed";
  :Ghi lỗi phục vụ debug (trace id);
endif

|UI|
:User mở lại trang hoặc auto-poll trạng thái;
if (Trạng thái = completed?) then (Yes)
  :Hiển thị dữ liệu gợi ý đã trích xuất;
  stop
else (No)
  if (Trạng thái = failed?) then (Yes)
    :Báo "Không thể phân tích CV" + gợi ý định dạng chuẩn;
    stop
  else (processing)
    :Tiếp tục chờ / cho phép hủy & tải lại CV;
    stop
  endif
endif
@enduml
