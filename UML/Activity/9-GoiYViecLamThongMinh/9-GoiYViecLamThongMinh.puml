@startuml
title ACT-AI-SUGGESTIONS (Detailed — lanes: User, UI, AI, Job, Analytics)

|User|
start
:Open "Việc làm gợi ý";

|UI|
:Đọc bộ lọc mặc định (địa điểm, lương, loại việc...);
:Send getSuggestions(userId, filters);

|AI|
:Kiểm tra cache theo user+filters;
if (Có cache hợp lệ?) then (Yes)
  |UI|
  :Render danh sách gợi ý (từ cache);

  split
    :Khởi động ghi nhận lượt hiển thị;
    |Analytics|
    :Log impressions(listId, jobIds);
  split again
    |UI|
    :Cho phép Save/Hide/Apply trên từng job;
  end split

  stop
else (No)
  :Chuẩn bị đặc trưng người dùng (profile + hành vi);

  ' Tải song song hồ sơ đã phân tích và hành vi gần đây
  split
    :Đọc hồ sơ trích xuất (skills/exp/edu) từ kho dữ liệu;
  split again
    :Đọc hành vi gần đây (search/view/save/apply);
  end split

  |Job|
  :Lấy danh sách job đang mở (paginate);

  |AI|
  :Tiền lọc theo filters/qualification;
  :Tính điểm phù hợp (embedding + rule-based);
  :Rerank theo độ mới, lương, vị trí, ưu tiên doanh nghiệp;
  :Tạo lý do gợi ý (kỹ năng khớp, địa điểm, mức lương);
  :Lưu cache ngắn hạn;

  |UI|
  :Render danh sách gợi ý + lý do;

  split
    :Khởi động ghi nhận sự kiện (impression/click/save/hide);
    |Analytics|
    :Ghi nhận & cập nhật hồ sơ học máy;
  split again
    |UI|
    :CTA: Xem chi tiết / Ứng tuyển / Lưu / Ẩn;
  end split

  stop
endif
@enduml
