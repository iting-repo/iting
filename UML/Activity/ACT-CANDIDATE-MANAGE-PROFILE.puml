@startuml
title ACT-CANDIDATE-MANAGE-PROFILE (Professional Record & CV)

skinparam activity {
  BackgroundColor #ffffff
  DiamondBackgroundColor #EEF2FF
  StartColor #10B981
  EndColor #EF4444
  ArrowColor #6366F1
}

|Candidate|
start
:Mở trang "Hồ sơ của tôi";

|Frontend (UI)|
:Lấy UserProfile (GET /api/user/professional-profile);
:Render các phần (Basic, Education, Experience, Skills, CV...);

|Candidate|
if (Thay đổi?) then (Thông tin cơ bản)
  :Nhập giới thiệu, mục tiêu;
  |Frontend (UI)|
  :Gửi PUT /api/user/professional-profile;
  |Backend (UserProfileService)|
  :Cập nhật UserProfile;

elseif (Hạng mục chuyên môn) then (Thêm/Sửa/Xóa)
  |Candidate|
  :Chọn phần (Học vấn, Kinh nghiệm, Kỹ năng, Chứng chỉ);
  :Nhập thông tin chi tiết;
  |Frontend (UI)|
  :Gửi POST/PUT/DELETE tới endpoint tương ứng;
  |Backend (UserProfileService)|
  :Lưu thay đổi vào các bảng liên quan;

elseif (Quản lý CV) then (Tải lên/Cài đặt)
  |Candidate|
  :Tải lên file CV mới;
  |Frontend (UI)|
  :Gửi POST /api/user/professional-profile/cv;
  |Backend (UserProfileService)|
  :Lưu tệp CV & tiêu đề;
  
  |Candidate|
  :Chọn "Đặt làm CV mặc định";
  |Frontend (UI)|
  :Gửi PATCH /cv/{id}/default;
endif

|Frontend (UI)|
:Hiển thị "Cập nhật thành công";
:Làm mới dữ liệu hồ sơ;

stop
@enduml
