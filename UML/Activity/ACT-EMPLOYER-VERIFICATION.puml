@startuml
title ACT-EMPLOYER-VERIFICATION (KYB & Trust Verification)

skinparam activity {
  BackgroundColor #ffffff
  DiamondBackgroundColor #EEF2FF
  StartColor #10B981
  EndColor #EF4444
  ArrowColor #6366F1
}

|Employer (HR)|
start
:Mở "Cài đặt Công ty";
:Tải lên Giấy phép kinh doanh\n& thông tin pháp lý;

|Frontend (UI)|
:Gửi yêu cầu cập nhật hồ sơ;

|Admin|
:Truy cập "Quản lý đối tác";
:Lọc danh sách PENDING (getPendingReviewCompanies);

|Frontend (UI)|
:Hiển thị hồ sơ chờ duyệt;

|Admin|
:Xem Giấy phép kinh doanh (viewCompanyBusinessLicense);
:Kiểm tra thông tin cơ bản;

if (Thông tin hợp lệ?) then (Cần làm rõ)
  :Thêm ghi chú nội bộ (addCompanyKybNote);
  :Yêu cầu bổ sung hồ sơ (requestResubmission);
  |Frontend (UI)|
  :Thông báo bổ sung cho Employer;
  stop
else (Có/Không)
  if (Duyệt?) then (Phê duyệt)
    |Admin|
    :Chọn mức xác thực (BASIC / VERIFIED / PREMIUM);
    :Gửi yêu cầu /{id}/approve;
    |Backend (AdminCompanyService)|
    :Cập nhật VerificationLevel;
    :Kích hoạt các quyền hạn cao cấp;
    :Gửi thông báo thành công;
  else (Từ chối)
    |Admin|
    :Nhập lý do từ chối;
    :Gửi yêu cầu /{id}/reject;
    |Backend (AdminCompanyService)|
    :Chuyển status -> REJECTED;
  endif
endif

|Frontend (UI)|
:Cập nhật trạng thái trên Dashboard;
:Lưu Audit Log (CompanyAuditAction);

stop
@enduml
