@startuml
title ACT-REGISTER-EMAIL (Revised - Process based on AuthServiceImpl)

skinparam activity {
  BackgroundColor #ffffff
  DiamondBackgroundColor #EEF2FF
  StartColor #10B981
  EndColor #EF4444
  ArrowColor #6366F1
}

|User|
start
:Open Register Page;
:Nhập email, password & chọn Role\n(Candidate hoặc Employer);

|UI|
:Validate form (email format, độ dài mật khẩu...);

|Auth (Backend)|
if (Email đã tồn tại & đã ACTIVE?) then (Yes)
  |UI|
  :Hiển thị thông báo "Email đã tồn tại";
  stop
else (No)
  |Auth (Backend)|
  :Hash mật khẩu;
  :Tạo bản ghi **Account** (status = **PENDING**);
  
  if (Role == CANDIDATE?) then (Yes)
    :Khởi tạo **User Profile** (Hồ sơ ứng viên);
  else (Yes)
    :Khởi tạo **Company Profile** (Hồ sơ công ty);
  endif

  :Tạo mã **OTP** (6 chữ số);
  :Lưu OTP vào DB + Expire time (5 phút);

  split
    |Mail Service|
    :Gửi email OTP chứa mã xác thực;
  split again
    |Auth (Backend)|
    :Ghi log Audit hệ thống;
  end split

  |UI|
  :Hiển thị form nhập OTP;

  |User|
  :Nhập OTP code từ email;

  |Auth (Backend)|
  if (OTP trùng khớp & trong thời hạn?) then (Yes)
    :Chuyển trạng thái Account -> **ACTIVE**;
    :Xóa mã OTP cũ;
    |UI|
    :Hiển thị thông báo thành công;
    :Điều hướng sang trang **Đăng nhập**;
  else (No)
    |UI|
    :Hiển thị lỗi "Mã OTP sai hoặc hết hạn";
    :Cho phép "Gửi lại OTP";
  endif

endif

stop
@enduml
