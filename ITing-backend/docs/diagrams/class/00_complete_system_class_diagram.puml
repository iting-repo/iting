  }

  enum SenderType {
    USER
    COMPANY
  }

  enum ReceiverType {
    USER
    COMPANY
  }

  class Conversation {
    - id : Long <<PK>>
    - type : ConversationType
    - participant1Id : Long
    - participant2Id : Long
    - lastMessageId : Long
    - lastMessageContent : String
    - lastMessageTime : LocalDateTime
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
  }

  class Message {
    - id : Long <<PK>>
    - conversationId : Long <<FK>>
