' ══════════════════════════════════════════════════
' PACKAGE: ADMIN
' ══════════════════════════════════════════════════
package "admin" #FEF3C7 {
  class Admin {
    - id : Long <<PK, FK → Account>>
    - loginCount : Integer
    - lastLoginIp : String
