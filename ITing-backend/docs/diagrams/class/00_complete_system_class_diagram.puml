@startuml 00 - Complete System Class Diagram

!theme plain
skinparam classBackgroundColor #FAFAFA
skinparam classBorderColor #4B5563
skinparam classArrowColor #1F2937
skinparam classHeaderBackgroundColor #E0E7FF
skinparam roundcorner 8
skinparam classFontSize 11
skinparam packageBackgroundColor #F8FAFF
skinparam packageBorderColor #818CF8
skinparam packageFontStyle bold
skinparam packageFontSize 12
