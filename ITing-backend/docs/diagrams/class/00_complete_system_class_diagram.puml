' ══════════════════════════════════════════════════
' INHERITANCE
' ══════════════════════════════════════════════════
AuditEntity <|-- RefreshToken
AuditEntity <|-- PasswordResetToken
AuditEntity <|-- CompanyHrAffiliation
AuditEntity <|-- UserJobInteraction
AuditEntity <|-- UserSearchHistory
AuditEntity <|-- Account

' ══════════════════════════════════════════════════
' AUTH RELATIONSHIPS
' ══════════════════════════════════════════════════
Account "1" *--> "0..*" RefreshToken        : has
Account "1" *--> "0..*" PasswordResetToken  : has
Account "1" *--> "0..*" BanHistory          : targetAccount
Account "1" --> "0..*" BanHistory           : adminAccount

' ══════════════════════════════════════════════════
' AUTH → CANDIDATE / ADMIN (role-specific profile)
' ══════════════════════════════════════════════════
Account "1" *--> "0..1" CandidateProfile    : owns (MapsId, chỉ CANDIDATE)
Account "1" *--> "0..1" Admin               : owns (MapsId, chỉ ADMIN)

' ══════════════════════════════════════════════════
' CANDIDATE PROFILE → DETAILED PROFILE
' ══════════════════════════════════════════════════
CandidateProfile "1" *--> "1" UserProfile   : has (MapsId)
CandidateProfile "1" *--> "1" ContactInfo   : has

UserProfile "1" *--> "0..*" CV
UserProfile "1" *--> "0..*" Experience
UserProfile "1" *--> "0..*" Education
UserProfile "1" *--> "0..*" Skill
UserProfile "1" *--> "0..*" Certificate
UserProfile "1" *--> "0..*" SocialLink
UserProfile "1" *--> "0..*" Portfolio

' ══════════════════════════════════════════════════
' COMPANY RELATIONSHIPS
' ══════════════════════════════════════════════════
Company "1" *--> "0..*" Job                 : posts
Company "1" *--> "0..*" CompanyHrAffiliation
Company "1" *--> "0..*" CompanyReview
Company "1" *--> "0..*" CompanyKybNote
Company "1" *--> "0..*" CompanyAuditLog

CompanyHrAffiliation "0..*" --> "1" Account : hrAccount
CompanyReview "0..*" --> "1" Account        : reviewer
UserFollowCompany "0..*" --> "1" Account
UserFollowCompany "0..*" --> "1" Company

' ══════════════════════════════════════════════════
' JOB RELATIONSHIPS
' ══════════════════════════════════════════════════
Job "1" *--> "0..*" JobReviewHistory
Job "0..*" --> "1" Company                  : belongsTo

UserSaveJob "0..*" --> "1" Account
UserSaveJob "0..*" --> "1" Job

CompanyUploadJob "0..*" --> "1" Job
CompanyUploadJob "0..*" --> "1" Company
CompanyUploadJob "0..*" --> "1" Admin       : approvedBy

' ══════════════════════════════════════════════════
' APPLICATION RELATIONSHIPS
' ══════════════════════════════════════════════════
ApplyFormSentToJob "0..*" --> "1" Job       : appliesTo
ApplyFormSentToJob "1" *--> "1" ApplyForm
ApplyFormSentToJob "0..*" --> "1" Account   : candidate
ApplyForm "0..*" --> "0..1" CV              : attaches

' ══════════════════════════════════════════════════
' MESSAGING RELATIONSHIPS
' ══════════════════════════════════════════════════
Conversation "1" *--> "0..*" Message

' ══════════════════════════════════════════════════
' RECOMMENDATION RELATIONSHIPS
' ══════════════════════════════════════════════════
UserJobInteraction "0..*" --> "1" Account
UserJobInteraction "0..*" --> "1" Job

UserSearchHistory "0..*" --> "1" Account

@enduml
