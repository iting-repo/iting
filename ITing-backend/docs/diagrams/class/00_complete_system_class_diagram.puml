title ITing Job Portal — Complete System Class Diagram

' ══════════════════════════════════════════════════
' ABSTRACT BASE
' ══════════════════════════════════════════════════
abstract class AuditEntity {
  # createdAt : LocalDateTime
  # updatedAt : LocalDateTime
}

' ══════════════════════════════════════════════════
' PACKAGE: AUTH
' ══════════════════════════════════════════════════
package "auth" #FFE4E6 {

  enum Role {
    CANDIDATE
    EMPLOYER
    ADMIN
  }

  enum AccountStatus {
    PENDING
    ACTIVE
    BANNED
    INACTIVE
  }

  class Account {
    - id : Long <<PK>>
    - email : String <<unique>>
    - passwordHash : String
    - role : Role
    - status : AccountStatus
    ' ── Thông tin chung — áp dụng cho mọi role ──
    - fullName : String
    - phone : String
    - avatarUrl : String
    ' ─────────────────────────────────────────────
    - lastLoginAt : LocalDateTime
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
  }
  note right of Account
    Single source of truth:
    fullName / phone / avatarUrl
    cho CANDIDATE, EMPLOYER, ADMIN
  end note

  class RefreshToken {
    - id : Long <<PK>>
    - tokenId : String
    - userId : Long <<FK>>
    - email : String
    - token : String
    - expiryDate : LocalDateTime
    - isUsed : Boolean
    - isRevoked : Boolean
    - deviceInfo : String
    - ipAddress : String
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
  }

  class OtpCode {
    - id : Long <<PK>>
    - email : String
    - code : String
    - expiryTime : LocalDateTime
    - isVerification : Boolean
  }

  class PasswordResetToken {
    - id : Long <<PK>>
    - token : String
    - expiresAt : LocalDateTime
    - used : Boolean
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
  }

  class BanHistory {
    - id : Long <<PK>>
    - reason : String
    - bannedAt : LocalDateTime
    - expiredAt : LocalDateTime
    - isActive : Boolean
  }
}

' ══════════════════════════════════════════════════
' PACKAGE: USER PROFILE
' ══════════════════════════════════════════════════
package "userprofile" #EEF2FF {

  enum EducationLevel {
    HIGH_SCHOOL
    ASSOCIATE
    BACHELOR
    MASTER
    DOCTOR
  }

  enum EmploymentStatus {
    UNEMPLOYED
    EMPLOYED
    FREELANCE
    SEEKING_CHANGE
  }

  enum CvStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
  }

  enum SocialPlatform {
    LINKEDIN
    GITHUB
    PORTFOLIO
    TWITTER
    FACEBOOK
  }

  class CandidateProfile {
    - id : Long <<PK, FK → Account>>
    - locId : Long
    - cvEmbedding : String
    - lastUpdate : LocalDateTime
  }
  note right of CandidateProfile
    Đổi tên từ "User" → rõ nghĩa hơn
    fullName/phone/avatarUrl đã ở Account
    Table: candidate_info
  end note

  class UserProfile {
    - id : Long <<PK, FK → CandidateProfile>>
    - headline : String
    - location : String
    - totalExperienceYears : Integer
    - educationSummary : EducationLevel
    - shortBio : String
    - employmentStatus : EmploymentStatus
    - openToWork : Boolean
    - updatedAt : LocalDateTime
  }

  class CV {
    - id : Long <<PK>>
    - title : String
    - fileName : String
    - fileUrl : String
    - s3Key : String
    - cvStatus : CvStatus
    - isDefault : Boolean
    - uploadedAt : LocalDateTime
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
  }

  class Experience {
    - id : Long <<PK>>
    - companyName : String
    - position : String
    - startDate : LocalDate
    - endDate : LocalDate
    - isCurrent : Boolean
    - description : String
  }

  class Education {
    - id : Long <<PK>>
    - schoolName : String
    - major : String
    - areaOfStudy : String
    - degree : String
    - startDate : LocalDate
    - endDate : LocalDate
    - description : String
  }

  class Skill {
    - id : Long <<PK>>
    - name : String
  }

  class Certificate {
    - id : Long <<PK>>
    - title : String
    - issuingOrganization : String
    - issueDate : LocalDate
    - expirationDate : LocalDate
    - credentialId : String
    - credentialUrl : String
    - doesNotExpire : Boolean
  }

  class SocialLink {
    - id : Long <<PK>>
    - platform : SocialPlatform
    - url : String
  }

  class Portfolio {
    - id : Long <<PK>>
    - title : String
    - url : String
    - description : String
  }

  class ContactInfo {
    - id : Long <<PK, FK → UserProfile>>
    - phone : String
    - email : String
    - showPhoneToRecruiter : Boolean
    - showEmailToRecruiter : Boolean
  }
}

