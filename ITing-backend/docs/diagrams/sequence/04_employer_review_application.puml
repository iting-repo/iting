@startuml 04 - Nhà tuyển dụng xem & duyệt đơn ứng tuyển

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam sequenceParticipantBackgroundColor #EEF2FF
skinparam sequenceParticipantBorderColor #6366F1
skinparam sequenceActorBackgroundColor #FEF9C3
skinparam sequenceLifeLineBorderColor #9CA3AF
skinparam sequenceArrowFontSize 11
skinparam noteBorderColor #6366F1
skinparam noteBackgroundColor #F0F9FF

title Sequence Diagram: Nhà tuyển dụng xem & cập nhật trạng thái đơn ứng tuyển

actor "HR" as hr
participant "EmployerApplicationController" as ctrl
participant "EmployerApplicationService" as svc
participant "AuthorizationService" as auth
participant "NotificationService" as notif
database "DB" as db

' ─────────────────────────────────────────────────
== 1. Xem danh sách đơn theo Job ==
' ─────────────────────────────────────────────────

hr -> ctrl : GET /api/employer/applications\n?jobId={id}&page=0&size=10
activate ctrl

ctrl -> svc : getApplicationsByJob(employerId, jobId, page, size)
activate svc

svc -> auth : verifyEmployerJobAccess(employerId, jobId)
activate auth
auth -> db : SELECT job WHERE id = jobId\nAND company.hrAccount = employerId
db --> auth : Job | null
alt Không có quyền truy cập
    auth --> svc : throw ForbiddenException
    svc --> ctrl : 403 Forbidden
    ctrl --> hr : 403 Forbidden "Không có quyền truy cập"
end
auth --> svc : authorized
deactivate auth

svc -> db : SELECT application\nWHERE jobId = jobId\nORDER BY timeSent DESC (pageable)
db --> svc : Page<ApplyFormSentToJob>

svc -> db : SELECT user, cv\nFOR EACH application (batch)
db --> svc : applicant info + CV details

svc --> ctrl : Page<ApplicationResponse>
deactivate svc
ctrl --> hr : 200 OK { content: [...],\ntotalElements, totalPages }
deactivate ctrl

' ─────────────────────────────────────────────────
== 2. Xem chi tiết & đánh dấu đã xem ==
' ─────────────────────────────────────────────────

hr -> ctrl : GET /api/employer/applications/{applicationId}
activate ctrl

ctrl -> svc : viewApplication(employerId, applicationId)
activate svc

svc -> auth : verifyApplicationAccess(employerId, applicationId)
activate auth
auth -> db : SELECT application JOIN job\nWHERE application.id = applicationId
db --> auth : application + job
auth --> svc : authorized
deactivate auth

svc -> db : SELECT ApplyFormSentToJob\nWHERE id = applicationId
db --> svc : ApplyFormSentToJob { status, cv, ... }

alt status == PENDING (lần đầu xem)
    svc -> db : UPDATE ApplyFormSentToJob\nSET status = VIEWED, viewedAt = now()
    db --> svc : updated
end

svc --> ctrl : ApplicationResponse { cv, applicantInfo,\ncoverLetter, status = VIEWED }
deactivate svc
ctrl --> hr : 200 OK
deactivate ctrl

' ─────────────────────────────────────────────────
== 3. Chấp nhận đơn ứng tuyển ==
' ─────────────────────────────────────────────────

hr -> ctrl : PATCH /api/employer/applications/{id}/status\n{ status: "ACCEPTED", note: "Phù hợp yêu cầu" }
activate ctrl

ctrl -> svc : updateApplicationStatus(employerId, applicationId, request)
activate svc

svc -> auth : verifyApplicationAccess(employerId, applicationId)
activate auth
auth -> db : SELECT application JOIN job JOIN company
db --> auth : authorized
deactivate auth

svc -> db : SELECT ApplyFormSentToJob WHERE id = applicationId
db --> svc : application { status = VIEWED }

svc -> db : UPDATE ApplyFormSentToJob\nSET status = ACCEPTED,\n    hrNote = note,\n    updatedAt = now()
db --> svc : OK

svc -> db : UPDATE Job\nSET currentAccepted = currentAccepted + 1\nWHERE id = jobId
db --> svc : OK

note over svc, notif : Gửi thông báo kết quả cho ứng viên

svc -> notif : notifyApplicationStatusChanged(\n  candidateId, applicationId,\n  status = ACCEPTED, note\n)
activate notif

notif -> db : INSERT INTO Notification {\n  recipientId = candidateId,\n  type = APPLICATION_STATUS_CHANGED,\n  content = "Đơn ứng tuyển được chấp nhận",\n  entityId = applicationId,\n  isRead = false\n}
db --> notif : saved

notif -> notif : pushWebSocket(\n  /user/{candidateId}/queue/notifications\n)
note right of notif : Gửi real-time qua STOMP\nnếu ứng viên đang online

notif --> svc : (async)
deactivate notif

svc --> ctrl : ApplicationResponse { status = ACCEPTED }
deactivate svc
ctrl --> hr : 200 OK
deactivate ctrl

' ─────────────────────────────────────────────────
== 4. Từ chối hàng loạt (Bulk Reject) ==
' ─────────────────────────────────────────────────

hr -> ctrl : POST /api/employer/applications/bulk-reject\n{ applicationIds: [1,2,3], note: "Không phù hợp" }
activate ctrl

ctrl -> svc : bulkReject(employerId, applicationIds, note)
activate svc

svc -> auth : verifyEmployerOwnsApplications(employerId, applicationIds)
activate auth
auth -> db : SELECT applications WHERE id IN (...)
db --> auth : applications
auth --> svc : authorized
deactivate auth

svc -> db : UPDATE ApplyFormSentToJob\nSET status = REJECTED, hrNote = note\nWHERE id IN (applicationIds)
db --> svc : rowsUpdated = n

svc -> notif : bulkNotify(candidateIds, REJECTED, note)
activate notif
notif -> db : INSERT INTO Notification (batch)\nFOR EACH candidateId
db --> notif : saved

notif -> notif : pushWebSocket cho từng\nứng viên (async)
notif --> svc : (async)
deactivate notif

svc --> ctrl : void
deactivate svc
ctrl --> hr : 200 OK "Đã từ chối {n} đơn thành công"
deactivate ctrl

@enduml
