@startuml 01 - Đăng ký tài khoản & Xác thực OTP

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam sequenceParticipantBackgroundColor #EEF2FF
skinparam sequenceParticipantBorderColor #6366F1
skinparam noteBackgroundColor #FEF9C3

title Sequence Diagram: Đăng ký tài khoản & Xác thực OTP

actor "Ứng viên" as user
participant "AuthController\n/api/auth" as ctrl #EEF2FF
participant "AuthServiceImpl" as svc #EEF2FF
participant "PasswordEncoder" as enc #F0FDF4
participant "AccountRepository" as accRepo #FFF7ED
participant "UserRepository" as userRepo #FFF7ED
participant "UserProfileRepository" as profileRepo #FFF7ED
participant "OtpCodeRepository" as otpRepo #FFF7ED
participant "EmailService" as email #FDF4FF

== Bước 1: Đăng ký ==

user -> ctrl : POST /api/auth/register\n{ email, password, fullName }
activate ctrl

ctrl -> svc : register(RegisterRequest)
activate svc

svc -> accRepo : existsByEmail(email)
accRepo --> svc : false

svc -> enc : encode(password)
activate enc
enc --> svc : passwordHash
deactivate enc

svc -> accRepo : save(Account { email, passwordHash,\nrole=CANDIDATE, status=PENDING })
accRepo --> svc : savedAccount

svc -> userRepo : save(User { id=account.id, fullName })
userRepo --> svc : savedUser

svc -> profileRepo : save(UserProfile { id=user.id })
profileRepo --> svc : savedProfile

note right of svc : Tạo mã OTP 6 chữ số\nhết hạn sau 15 phút

svc -> otpRepo : save(OtpCode { email, code, expiry=+15min, isVerification=true })
otpRepo --> svc : savedOtp

svc -> email : sendVerificationEmail(email, otpCode)
activate email
email --> svc : sent
deactivate email

svc --> ctrl : Account (status=PENDING)
deactivate svc

ctrl --> user : 201 Created\n"Vui lòng xác thực OTP qua email"
deactivate ctrl

== Bước 2: Xác thực OTP ==

user -> ctrl : POST /api/auth/verify-otp\n{ email, code }
activate ctrl

ctrl -> svc : verifyOtp(email, code)
activate svc

svc -> otpRepo : findByEmailAndCode(email, code)
otpRepo --> svc : OtpCode

alt OTP không tồn tại hoặc đã hết hạn
    svc --> ctrl : throw InvalidOtpException
    ctrl --> user : 400 Bad Request\n"OTP không hợp lệ hoặc đã hết hạn"
else OTP hợp lệ
    svc -> accRepo : findByEmail(email)
    accRepo --> svc : Account

    svc -> accRepo : save(Account { status=ACTIVE })
    accRepo --> svc : updatedAccount

    svc -> otpRepo : delete(otpCode)
    svc --> ctrl : void (success)
    ctrl --> user : 200 OK\n"Xác thực thành công"
end
deactivate svc
deactivate ctrl

== Bước 3: Gửi lại OTP (nếu cần) ==

user -> ctrl : POST /api/auth/resend-otp\n{ email }
activate ctrl
ctrl -> svc : resendOtp(email)
activate svc
svc -> otpRepo : deleteByEmail(email)
svc -> otpRepo : save(OtpCode mới)
svc -> email : sendVerificationEmail(email, newOtpCode)
svc --> ctrl : void
deactivate svc
ctrl --> user : 200 OK\n"OTP mới đã được gửi"
deactivate ctrl

@enduml
