@startuml 07 - HR đăng ký liên kết Công ty & Admin xác minh

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam sequenceParticipantBackgroundColor #EEF2FF

title Sequence Diagram: HR yêu cầu liên kết Công ty (KYB) → Admin xác minh

actor "HR" as hr
actor "Admin" as admin
participant "CompanyController\n/api/company" as ctrl
participant "CompanyServiceImpl" as svc
participant "CompanyRepository" as compRepo
participant "CompanyHrAffiliationRepo" as hrRepo
participant "FileUploadService" as fileService
participant "AdminAffiliationController\n/api/admin/affiliations" as adminCtrl
participant "AdminAffiliationServiceImpl" as adminSvc
participant "NotificationService" as notif

== Bước 1: HR tạo yêu cầu liên kết công ty ==

hr -> ctrl : POST /api/company/affiliation/request\n{\n  name, taxCode, website, address,\n  industries, description,\n  businessLicenseFile (multipart)\n}
activate ctrl

ctrl -> svc : createAffiliationRequest(hrAccountId, request)
activate svc

svc -> svc : validateHrRole(hrAccountId)

svc -> hrRepo : findByHrAccountId(hrAccountId)
hrRepo --> svc : null (chưa có affiliation)

alt HR đã có affiliation đang xử lý
    svc --> ctrl : throw DuplicateAffiliationException
    ctrl --> hr : 409 Conflict
end

svc -> compRepo : findByTaxCode(taxCode)
compRepo --> svc : null (công ty chưa tồn tại)

note right of svc : Tạo Company mới (draft)
svc -> compRepo : save(Company {\n  taxCode, name, address,\n  verificationLevel=UNVERIFIED,\n  active=false\n})
compRepo --> svc : newCompany

svc -> fileService : uploadFile(businessLicenseFile)
fileService --> svc : fileUrl (S3/Cloudinary)

svc -> hrRepo : save(CompanyHrAffiliation {\n  hrAccount, company,\n  status=PENDING,\n  submittedName, submittedLogoUrl,\n  submittedIndustries,\n  businessLicenseUrl=fileUrl,\n  submissionStatus=PENDING,\n  requestedAt=now\n})
hrRepo --> svc : savedAffiliation

svc -> notif : notifyAdminNewAffiliationRequest(affiliation)

svc --> ctrl : AffiliationResponse { id, status=PENDING }
deactivate svc
ctrl --> hr : 201 Created\n"Yêu cầu đã gửi, chờ Admin xét duyệt"
deactivate ctrl

== Bước 2: Admin xem & xét duyệt hồ sơ ==

admin -> adminCtrl : GET /api/admin/affiliations?status=PENDING
activate adminCtrl
adminCtrl -> adminSvc : getPendingAffiliations(page, size)
activate adminSvc
adminSvc -> hrRepo : findByStatus(PENDING, Pageable)
adminSvc --> adminCtrl : Page<AffiliationResponse>
deactivate adminSvc
adminCtrl --> admin : 200 OK { danh sách chờ duyệt }
deactivate adminCtrl

admin -> adminCtrl : GET /api/admin/affiliations/{id}
activate adminCtrl
adminCtrl -> adminSvc : getAffiliationDetail(id)
activate adminSvc
adminSvc --> adminCtrl : AffiliationDetail { hồ sơ, tài liệu }
deactivate adminSvc
adminCtrl --> admin : 200 OK
deactivate adminCtrl

== Bước 3a: Admin chấp thuận ==

admin -> adminCtrl : POST /api/admin/affiliations/{id}/approve
activate adminCtrl
adminCtrl -> adminSvc : approveAffiliation(adminId, affiliationId)
activate adminSvc

adminSvc -> hrRepo : findById(affiliationId)
hrRepo --> adminSvc : affiliation

adminSvc -> hrRepo : save(affiliation {\n  status=APPROVED,\n  reviewedBy=adminId,\n  reviewedAt=now\n})

note right of adminSvc : Áp dụng thông tin từ snapshot\nvào Company chính thức

adminSvc -> compRepo : save(company {\n  name=affiliation.submittedName,\n  logoUrl=affiliation.submittedLogoUrl,\n  industries=affiliation.submittedIndustries,\n  verificationLevel=VERIFIED,\n  active=true,\n  infoSourceAffiliationId=affiliationId\n})

adminSvc -> notif : notifyHrAffiliationApproved(hr, company)
adminSvc --> adminCtrl : void
deactivate adminSvc
adminCtrl --> admin : 200 OK\n"Đã phê duyệt công ty"
deactivate adminCtrl

== Bước 3b: Admin từ chối ==

admin -> adminCtrl : POST /api/admin/affiliations/{id}/reject\n{ reason: "Giấy phép không hợp lệ" }
activate adminCtrl
adminCtrl -> adminSvc : rejectAffiliation(adminId, affiliationId, reason)
activate adminSvc
adminSvc -> hrRepo : save(affiliation {\n  status=REJECTED,\n  rejectedReason=reason\n})
adminSvc -> notif : notifyHrAffiliationRejected(hr, reason)
adminSvc --> adminCtrl : void
deactivate adminSvc
adminCtrl --> admin : 200 OK
deactivate adminCtrl

@enduml
