@startuml 05 - Gửi tin nhắn & WebSocket Notification

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam sequenceParticipantBackgroundColor #EEF2FF

title Sequence Diagram: Nhắn tin & Thông báo WebSocket thời gian thực

actor "Người gửi\n(User/Company)" as sender
actor "Người nhận" as receiver
participant "MessageController\n/api/messages" as ctrl
participant "MessageServiceImpl" as svc
participant "ConversationRepository" as convRepo
participant "MessageRepository" as msgRepo
participant "DomainNotificationPublisher" as publisher
participant "WebSocketNotificationService" as ws
participant "NotificationRepository" as notifRepo
participant "STOMP WebSocket\n/ws" as stomp

== Bước 1: Kết nối WebSocket ==

receiver -> stomp : CONNECT /ws\n(JWT token in header)
stomp --> receiver : CONNECTED

receiver -> stomp : SUBSCRIBE /user/{userId}/queue/notifications
receiver -> stomp : SUBSCRIBE /user/{userId}/queue/messages

== Bước 2: Gửi tin nhắn ==

sender -> ctrl : POST /api/messages\n{\n  conversationId (optional),\n  receiverId, receiverType,\n  content\n}
activate ctrl
ctrl -> svc : sendMessage(SendMessageRequest, senderId)
activate svc

alt conversationId không có
    svc -> convRepo : findByParticipants(senderId, receiverId, type)
    convRepo --> svc : null (chưa có conversation)

    note right of svc : Tạo Conversation mới

    svc -> convRepo : save(Conversation {\n  participant1Id=senderId,\n  participant2Id=receiverId,\n  type=USER_TO_COMPANY\n})
    convRepo --> svc : newConversation
else conversationId có sẵn
    svc -> convRepo : findById(conversationId)
    convRepo --> svc : existingConversation
end

note right of svc : Lưu tin nhắn

svc -> msgRepo : save(Message {\n  conversationId,\n  senderId, senderType,\n  receiverId, receiverType,\n  content,\n  isRead=false,\n  createdAt=now\n})
msgRepo --> svc : savedMessage

svc -> convRepo : save(conversation {\n  lastMessageId=message.id,\n  lastMessageContent=content,\n  lastMessageTime=now\n})

== Bước 3: Gửi thông báo real-time ==

svc -> publisher : publishDomainEvent(MessageSentEvent {\n  messageId, conversationId,\n  senderId, receiverId,\n  content\n})
activate publisher

publisher -> notifRepo : save(Notification {\n  recipientId=receiverId,\n  type=MESSAGE_RECEIVED,\n  content="Tin nhắn mới từ..."\n})

publisher -> ws : pushToUser(receiverId, MessageNotification)
activate ws
ws -> stomp : SEND /user/{receiverId}/queue/messages\n{ messageId, senderId, content, conversationId }
stomp --> receiver : MESSAGE (nhận real-time)
ws --> publisher : done
deactivate ws

publisher --> svc : (async completed)
deactivate publisher

svc --> ctrl : MessageResponse {\n  id, content, conversationId,\n  createdAt, isRead=false\n}
deactivate svc
ctrl --> sender : 201 Created
deactivate ctrl

== Bước 4: Đánh dấu đã đọc ==

receiver -> ctrl : PATCH /api/messages/conversations/{id}/read
activate ctrl
ctrl -> svc : markAllMessagesAsReadInConversation(conversationId, userId)
activate svc
svc -> msgRepo : updateIsReadByConversationIdAndReceiverId(conversationId, userId, true)
svc --> ctrl : void
deactivate svc
ctrl --> receiver : 200 OK
deactivate ctrl

@enduml
