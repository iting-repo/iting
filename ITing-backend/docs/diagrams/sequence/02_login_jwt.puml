@startuml 02 - Đăng nhập & Làm mới Token

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam sequenceParticipantBackgroundColor #EEF2FF

title Sequence Diagram: Đăng nhập (JWT) & Google OAuth & Refresh Token

actor "Người dùng" as user
participant "AuthController\n/api/auth" as ctrl
participant "AuthServiceImpl" as svc
participant "AccountRepository" as accRepo
participant "JwtTokenUtil" as jwt
participant "RefreshTokenRepository" as rtRepo
participant "GoogleAuthService" as google

== Luồng 1: Đăng nhập thường ==

user -> ctrl : POST /api/auth/login\n{ email, password }
activate ctrl

ctrl -> svc : login(LoginRequest)
activate svc

svc -> accRepo : findByEmail(email)
accRepo --> svc : Account

alt Account không tồn tại
    svc --> ctrl : throw AuthException("Tài khoản không tồn tại")
    ctrl --> user : 401 Unauthorized
else Account bị BANNED
    svc --> ctrl : throw AccountBannedException
    ctrl --> user : 403 Forbidden\n"Tài khoản đã bị khóa"
else Account chưa ACTIVE (PENDING)
    svc --> ctrl : throw AccountNotVerifiedException
    ctrl --> user : 403 Forbidden\n"Chưa xác thực email"
else Credentials hợp lệ
    svc -> svc : passwordEncoder.matches(raw, hash)

    svc -> jwt : generateAccessToken(account)
    jwt --> svc : accessToken (TTL: 24h)

    svc -> jwt : generateRefreshToken(account)
    jwt --> svc : refreshToken (TTL: 7 ngày)

    svc -> rtRepo : save(RefreshToken { token, userId,\n deviceInfo, ipAddress, isUsed=false })
    rtRepo --> svc : savedRefreshToken

    svc -> accRepo : save(account { lastLoginAt=now })

    svc --> ctrl : LoginResponse { accessToken, refreshToken, role, userId }
    ctrl --> user : 200 OK + Set-Cookie: refreshToken
end
deactivate svc
deactivate ctrl

== Luồng 2: Đăng nhập Google OAuth ==

user -> ctrl : POST /api/auth/google\n{ googleIdToken }
activate ctrl
ctrl -> svc : loginWithGoogle(googleIdToken)
activate svc

svc -> google : getUserInfo(googleIdToken)
google --> svc : GoogleUserInfo { email, name, avatarUrl }

svc -> accRepo : findByEmail(email)
alt Account chưa tồn tại
    svc -> accRepo : save(Account { status=ACTIVE, role=CANDIDATE })
    svc -> svc : createUserAndProfile(account)
end

svc -> jwt : generateAccessToken(account)
svc -> jwt : generateRefreshToken(account)
svc -> rtRepo : save(RefreshToken)
svc --> ctrl : LoginResponse
ctrl --> user : 200 OK
deactivate svc
deactivate ctrl

== Luồng 3: Làm mới Access Token ==

user -> ctrl : POST /api/auth/refresh\n{ refreshToken }
activate ctrl
ctrl -> svc : refreshAccessToken(refreshToken)
activate svc

svc -> rtRepo : findByToken(refreshToken)
rtRepo --> svc : RefreshToken

alt Token đã dùng hoặc bị thu hồi
    svc -> rtRepo : revokeAllTokensForUser(userId)
    svc --> ctrl : throw TokenCompromisedException
    ctrl --> user : 401 Unauthorized\n"Token bị xâm phạm"
else Token hết hạn
    svc --> ctrl : throw TokenExpiredException
    ctrl --> user : 401 Unauthorized
else Token hợp lệ
    svc -> rtRepo : save(old { isUsed=true })
    svc -> jwt : generateAccessToken(account)
    svc -> rtRepo : save(RefreshToken mới)
    svc --> ctrl : newAccessToken
    ctrl --> user : 200 OK { accessToken }
end
deactivate svc
deactivate ctrl

@enduml
