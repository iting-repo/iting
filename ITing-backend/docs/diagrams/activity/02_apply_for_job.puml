@startuml 02 - Activity: Ứng viên nộp đơn xin việc

skinparam activityBackgroundColor #EEF2FF
skinparam activityBorderColor #6366F1
skinparam activityDiamondBackgroundColor #FEF9C3
skinparam activityArrowColor #374151
skinparam roundcorner 10

title Activity Diagram: Ứng viên tìm kiếm & nộp đơn xin việc

|Ứng viên|
start
:Tìm kiếm việc làm\n(keyword, location, salary, jobType);

:Xem danh sách kết quả\n(Job status = ACTIVE);

:Chọn xem chi tiết việc làm;

if (Đã đăng nhập?) then (Chưa)
  :Chuyển đến trang đăng nhập;
  :Đăng nhập thành công;
endif

if (Job còn hiệu lực?\n(dueDate >= today, status=ACTIVE)) then (Không)
  :Hiển thị "Tin đã hết hạn";
  stop
else (Có)
endif

if (Đã ứng tuyển trước đó?) then (Rồi)
  :Hiển thị "Bạn đã ứng tuyển";
  stop
else (Chưa)
endif

:Nhấn "Ứng tuyển ngay";

if (Có CV trên hệ thống?) then (Có)
  :Chọn CV từ danh sách;
else (Chưa có)
  :Upload CV mới\nhoặc điền thông tin thủ công;
endif

:Nhập thư giới thiệu (tuỳ chọn);

:Xác nhận nộp đơn;

|Hệ thống|
:Lưu ApplyForm;
:Lưu ApplyFormSentToJob\n(status = PENDING);
:Tăng Job.applicationCount;
:Gửi thông báo cho Nhà tuyển dụng;

|Ứng viên|
:Nhận thông báo\n"Nộp đơn thành công";

:Theo dõi trạng thái\nqua "Đơn ứng tuyển của tôi";

|Hệ thống|
:Cập nhật trạng thái\nkhi HR xem/chấp nhận/từ chối;
:Gửi push notification cho Ứng viên;

|Ứng viên|
if (Kết quả?) then (ACCEPTED)
  :Nhận thông báo\n"Đơn ứng tuyển được chấp nhận";
  :Chờ liên hệ phỏng vấn;
  stop
else (REJECTED)
  :Nhận thông báo\n"Đơn ứng tuyển bị từ chối";
  :Tiếp tục tìm kiếm công việc khác;
  stop
else (Muốn rút đơn)
  :Nhấn "Rút đơn";
  :Trạng thái → WITHDRAWN;
  stop
endif

@enduml
