@startuml 01 - Activity: Đăng ký & Xác thực tài khoản

skinparam activityBackgroundColor #EEF2FF
skinparam activityBorderColor #6366F1
skinparam activityDiamondBackgroundColor #FEF9C3
skinparam activityArrowColor #374151
skinparam roundcorner 10

title Activity Diagram: Đăng ký & Xác thực tài khoản người dùng

start

:Người dùng nhập email, mật khẩu, họ tên;

if (Email đã tồn tại?) then (Có)
  :Trả về lỗi\n"Email đã được sử dụng";
  stop
else (Không)
endif

if (Mật khẩu đủ mạnh?\n(≥8 ký tự, chữ hoa, số)) then (Không)
  :Trả về lỗi validation;
  stop
else (Có)
endif

:Mã hoá mật khẩu (BCrypt);

:Tạo Account\n(status = PENDING);

:Tạo User + UserProfile + ContactInfo;

:Tạo OtpCode\n(6 chữ số, hết hạn 15 phút);

:Gửi email xác thực chứa OTP;

:Trả về 201 Created\n"Kiểm tra email để xác thực";

fork
  :Người dùng nhập OTP từ email;
  if (OTP hợp lệ &\nchưa hết hạn?) then (Có)
    :Cập nhật Account\n(status = ACTIVE);
    :Xoá OtpCode;
    :Đăng ký thành công;
    stop
  else (Không / Hết hạn)
    if (Còn muốn thử?) then (Có)
      :Gửi lại OTP mới;
      note right: Xoá OTP cũ\nTạo OTP mới
    else (Không)
      :Tài khoản vẫn ở trạng thái PENDING;
      stop
    endif
  endif
fork again
  :Quá 15 phút không xác thực;
  :OTP hết hạn tự động;
  :Người dùng cần nhấn\n"Gửi lại OTP";
end fork

@enduml
