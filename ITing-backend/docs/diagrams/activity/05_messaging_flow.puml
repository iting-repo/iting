@startuml 05 - Activity: Luồng nhắn tin

skinparam activityBackgroundColor #EEF2FF
skinparam activityBorderColor #6366F1
skinparam activityDiamondBackgroundColor #FEF9C3
skinparam activityArrowColor #374151
skinparam roundcorner 10

title Activity Diagram: Luồng nhắn tin giữa Ứng viên & Nhà tuyển dụng

|Người dùng|
start
:Kết nối WebSocket\n(/ws endpoint, JWT auth);

:Đăng ký nhận thông báo\n(SUBSCRIBE /user/{id}/queue/messages);

:Mở giao diện tin nhắn;

if (Đã có conversation\nvới người nhận?) then (Có)
  :Mở conversation hiện có;
  :Tải lịch sử tin nhắn;
  :Đánh dấu tất cả là đã đọc;
else (Chưa)
  :Tạo conversation mới\n(tự động khi gửi tin đầu tiên);
endif

:Soạn nội dung tin nhắn;

if (Nội dung hợp lệ\n(không rỗng)?) then (Không)
  :Hiển thị lỗi;
else (Có)
  :Gửi POST /api/messages;

  |Hệ thống|
  if (Conversation đã tồn tại?) then (Chưa)
    :Tạo Conversation mới\n(participant1=sender,\nparticipant2=receiver);
  endif

  :Lưu Message\n(isRead=false);
  :Cập nhật lastMessage\ntrong Conversation;

  fork
    :Trả về MessageResponse\ncho người gửi;
  fork again
    :Publish MessageSentEvent;
    :Lưu Notification\ncho người nhận;
    :Push WebSocket đến\n người nhận (nếu online);
  end fork

  |Người nhận|
  if (Đang online?) then (Có)
    :Nhận tin nhắn real-time\nqua WebSocket;
    :Hiển thị tin nhắn mới;
    :Đánh dấu đã đọc tự động;
  else (Không online)
    :Nhận push notification\n(khi mở app lại);
    :Xem tin nhắn chưa đọc;
    :Đánh dấu đã đọc\nkhi mở conversation;
  endif

  |Người nhận|
  :Soạn và gửi phản hồi;
  note right: Lặp lại quy trình\ngửi tin nhắn
endif

stop

@enduml
