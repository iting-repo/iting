@startuml 04 - Activity: Xác minh Công ty (KYB)

skinparam activityBackgroundColor #EEF2FF
skinparam activityBorderColor #6366F1
skinparam activityDiamondBackgroundColor #FEF9C3
skinparam activityArrowColor #374151
skinparam roundcorner 10

title Activity Diagram: HR gửi yêu cầu liên kết & xác minh Công ty (KYB)

|HR|
start
:Đăng nhập với vai trò HR;

if (Đã có AffiliationStatus = APPROVED?) then (Có)
  :Đã liên kết công ty;
  stop
else (Chưa)
endif

:Điền thông tin công ty\n(tên, mã số thuế, địa chỉ,\nlĩnh vực, quy mô, mô tả);

:Upload giấy phép kinh doanh\n(PDF/Image);

:Upload văn bản đồng thuận\n(nếu yêu cầu);

:Gửi yêu cầu liên kết;

|Hệ thống|
if (Mã số thuế đã tồn tại?) then (Có)
  :Liên kết HR với Company hiện có;
else (Không)
  :Tạo Company mới\n(verificationLevel = UNVERIFIED);
endif

:Lưu CompanyHrAffiliation\n(status = PENDING);
:Upload file lên S3;
:Gửi thông báo cho Admin;

|HR|
:Chờ Admin xét duyệt\n(trạng thái: PENDING);

|Admin|
:Nhận thông báo hồ sơ mới;
:Xem hồ sơ công ty & tài liệu;

if (Tài liệu hợp lệ &\nthông tin đầy đủ?) then (Hợp lệ)
  :Phê duyệt AffiliationRequest;

  |Hệ thống|
  :CompanyHrAffiliation.status = APPROVED;
  :Áp dụng snapshot vào Company chính thức\n(name, logo, industries từ submission);
  :Company.verificationLevel = VERIFIED;
  :Company.active = true;
  :Gửi thông báo HR được duyệt;

  |HR|
  :Nhận thông báo\n"Công ty đã được xác minh";
  :Có thể đăng tin tuyển dụng;
  stop

else (Không hợp lệ)
  if (Cần bổ sung thêm?) then (Có)
    :Yêu cầu HR bổ sung\n(ghi chú qua KybNote);

    |HR|
    :Nhận yêu cầu bổ sung;
    :Upload thêm tài liệu;
    :Gửi lại hồ sơ;
  else (Từ chối hoàn toàn)
    :Từ chối với lý do chi tiết;

    |Hệ thống|
    :CompanyHrAffiliation.status = REJECTED;
    :Gửi thông báo HR bị từ chối;

    |HR|
    :Nhận thông báo\n"Hồ sơ bị từ chối: {lý do}";
    if (Muốn gửi lại?) then (Có)
      :Tạo yêu cầu mới;
    else (Không)
      stop
    endif
  endif
endif

@enduml
