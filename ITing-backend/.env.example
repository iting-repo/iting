# ==========================================
# Docker + AWS S3 configuration example
# Copy to .env and fill in your values
# ==========================================

# Database (docker-compose currently uses local postgres defaults)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=iting_job_portal
DB_USER=postgres
DB_PASSWORD=250904

# AWS S3
AWS_ENABLED=true
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your_bucket_name

# Application
APP_ENV=production

# OpenAI (optional) - for employer candidate AI search embeddings
# If not set, backend will fallback to simple keyword scoring.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
