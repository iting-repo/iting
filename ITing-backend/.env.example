# ==========================================
# AWS RDS Configuration Example
# Copy to .env and fill in your values
# ==========================================

# Database (AWS RDS)
DB_HOST=iting-db.xxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=iting_job_web
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Application
APP_ENV=production
