@startuml RBAC_Job_Portal_Class_Diagram

!theme plain
skinparam classAttributeIconSize 0

' ========== PACKAGES ==========

package "Authentication Layer" {
    
    abstract class AuditEntity {
        - LocalDateTime createdAt
        - LocalDateTime updatedAt
        + getCreatedAt(): LocalDateTime
        + getUpdatedAt(): LocalDateTime
    }
    
    class Account {
        - Long id
        - String email
        - String passwordHash
        - AccountStatus status
        - LocalDateTime lastLoginAt
        - Set<Role> roles
        + login(String, String): LoginResponse
        + logout(): void
        + hasRole(String): boolean
        + getPermissions(): Set<String>
    }
    
    enum AccountStatus {
        ACTIVE
        BANNED
        PENDING
    }
    
    Account --|> AuditEntity
    Account "1" *-- "1..*" Role : has >
}

package "Authorization Layer" {
    
    class Role {
        - Long id
        - String name
        - String description
        - Set<Permission> permissions
        + addPermission(Permission): void
        + hasPermission(String): boolean
        + getPermissionCodes(): Set<String>
    }
    
    class Permission {
        - Long id
        - String code
        - String name
        - String module
        - String action
        + checkAccess(String): boolean
    }
    
    Role --|> AuditEntity
    Permission --|> AuditEntity
    Role "1" *-- "1..*" Permission : contains >
}

package "Business Layer" {
    
    class Job {
        - Long id
        - String position
        - String description
        - String requirements
        - String techRequired
        - String location
        - JobType jobType
        - ExperienceLevel experienceLevel
        - Long minSalary
        - Long maxSalary
        - JobStatus status
        - Long employerId
        - LocalDateTime dueDate
        + create(): Job
        + update(): Job
        + approve(): void
        + close(): void
        + isExpired(): boolean
    }
    
    enum JobType {
        FULL_TIME
        PART_TIME
        CONTRACT
        INTERNSHIP
        REMOTE
    }
    
    enum ExperienceLevel {
        ENTRY
        JUNIOR
        MID
        SENIOR
        LEAD
    }
    
    enum JobStatus {
        PENDING
        ACTIVE
        CLOSED
        EXPIRED
    }
    
    Job --|> AuditEntity
}

package "Application Management" {
    
    class Application {
        - Long id
        - Long jobId
        - Long candidateId
        - String coverLetter
        - Long expectedSalary
        - ApplicationStatus status
        - LocalDateTime appliedAt
        + submit(): Application
        + updateStatus(ApplicationStatus): void
        + withdraw(): void
    }
    
    enum ApplicationStatus {
        PENDING
        REVIEWING
        ACCEPTED
        REJECTED
        WITHDRAWN
    }
    
    Application --|> AuditEntity
}

package "User Management" {
    
    class Company {
        - Long id
        - String name
        - String description
        - String logoUrl
        - String website
        - String address
        - CompanySize size
        - String industry
        + updateProfile(): Company
        + uploadLogo(String): void
    }
    
    enum CompanySize {
        STARTUP
        SMALL
        MEDIUM
        LARGE
        ENTERPRISE
    }
    
    class User {
        - Long id
        - String firstName
        - String lastName
        - String phone
        - String address
        - String avatarUrl
        - List<String> skills
        - String experience
        - String education
        - String resumeUrl
        + updateProfile(): User
        + uploadResume(String): void
        + addSkill(String): void
    }
    
    Company --|> AuditEntity
    User --|> AuditEntity
}

package "Admin Management" {
    
    class Category {
        - Long id
        - String type
        - String name
        - String nameEn
        - String description
        - String icon
        - Long parentId
        - Integer sortOrder
        - Boolean active
        + create(): Category
        + update(): Category
        + activate(): void
        + deactivate(): void
    }
    
    class ActivityLog {
        - Long id
        - Long adminId
        - String action
        - String entityType
        - Long entityId
        - String description
        - String ipAddress
        - String userAgent
        + log(): void
        + getRecentActivities(): List<ActivityLog>
    }
    
    class UserReport {
        - Long id
        - Long reporterId
        - Long reportedUserId
        - String type
        - String reason
        - String description
        - String status
        - String adminNote
        - Long handledBy
        - LocalDateTime handledAt
        + submit(): UserReport
        + handle(String, String): void
    }
    
    Category --|> AuditEntity
    ActivityLog --|> AuditEntity
    UserReport --|> AuditEntity
}

' ========== RELATIONSHIPS ==========

Account "1" -- "0..1" Company : owns >
Account "1" -- "0..1" User : has >

Job "1" -- "1" Account : employer >
Job "1" -- "0..*" Application : receives >

Application "1" -- "1" Job : for >
Application "1" -- "1" Account : candidate >

ActivityLog "1" -- "1" Account : admin >
UserReport "1" -- "1" Account : reporter >
UserReport "1" -- "1" Account : reported >

Category "1" -- "0..*" Job : categorizes >

' ========== REPOSITORIES ==========

package "Repositories" {
    
    interface AccountRepository {
        + findByEmail(String): Optional<Account>
        + findByEmailWithRolesAndPermissions(String): Optional<Account>
        + findPermissionCodesByAccountId(Long): Set<String>
        + countByRoles_Name(String): long
        + countByStatus(AccountStatus): long
        + countByCreatedAtAfter(LocalDateTime): long
    }
    
    interface JobRepository {
        + findByEmployerId(Long): List<Job>
        + findByStatus(JobStatus): List<Job>
        + countByEmployerIdAndStatus(Long, JobStatus): long
        + searchJobs(...): Page<Job>
    }
    
    interface ApplicationRepository {
        + findByJobId(Long): List<Application>
        + findByCandidateId(Long): List<Application>
        + findByStatus(ApplicationStatus): List<Application>
    }
    
    interface CategoryRepository {
        + findByTypeOrderBySortOrderAsc(String): List<Category>
        + existsByTypeAndName(String, String): boolean
    }
    
    interface ActivityLogRepository {
        + findByUserIdOrderByCreatedAtDesc(Long, Pageable): Page<ActivityLog>
        + findRecentActivities(LocalDateTime, Pageable): List<ActivityLog>
    }
}

' ========== SERVICES ==========

package "Services" {
    
    class AuthService {
        - AccountRepository accountRepository
        - JwtTokenProvider jwtProvider
        - PasswordEncoder passwordEncoder
        + login(LoginRequest): LoginResponse
        + logout(String): void
        + refreshToken(String): TokenResponse
        + validateToken(String): boolean
        + getCurrentUser(String): UserDetails
    }
    
    class AdminService {
        - AccountRepository accountRepository
        - JobRepository jobRepository
        - CategoryRepository categoryRepository
        - ActivityLogRepository activityLogRepository
        + getUsers(...): Page<UserListResponse>
        + getDashboardStats(): DashboardStats
        + approveJob(Long): void
        + banUser(Long, BanUserRequest): void
        + createCategory(Category): Category
        + getActivityLogs(...): Page<ActivityLog>
    }
    
    class JobService {
        - JobRepository jobRepository
        - ApplicationRepository applicationRepository
        + createJob(CreateJobRequest): Job
        + updateJob(Long, UpdateJobRequest): Job
        + searchJobs(JobSearchRequest): Page<Job>
        + applyToJob(Long, ApplicationRequest): Application
        + getMyJobs(Long): Page<Job>
    }
    
    class UserService {
        - UserRepository userRepository
        - ApplicationRepository applicationRepository
        + updateProfile(Long, ProfileRequest): User
        + getMyApplications(Long): Page<Application>
        + uploadResume(Long, MultipartFile): String
    }
}

' ========== CONTROLLERS ==========

package "Controllers" {
    
    class AuthController {
        - AuthService authService
        + postLogin(@RequestBody LoginRequest): ResponseEntity<LoginResponse>
        + postLogout(@RequestHeader String): ResponseEntity<Void>
        + postRefresh(@RequestBody RefreshRequest): ResponseEntity<TokenResponse>
        + getProfile(@AuthenticationPrincipal User): ResponseEntity<UserProfile>
    }
    
    class AdminController {
        - AdminService adminService
        + getUsers(@RequestParam Map): ResponseEntity<Page<UserListResponse>>
        + getDashboardStats(): ResponseEntity<DashboardStats>
        + postApproveJob(@PathVariable Long): ResponseEntity<Void>
        + postBanUser(@PathVariable Long, @RequestBody BanUserRequest): ResponseEntity<Void>
        + getCategories(): ResponseEntity<List<Category>>
        + postCategory(@RequestBody Category): ResponseEntity<Category>
    }
    
    class JobController {
        - JobService jobService
        + getJobs(@RequestParam Map): ResponseEntity<Page<JobResponse>>
        + getJob(@PathVariable Long): ResponseEntity<JobResponse>
        + postJob(@RequestBody CreateJobRequest): ResponseEntity<JobResponse>
        + putJob(@PathVariable Long, @RequestBody UpdateJobRequest): ResponseEntity<JobResponse>
        + searchJobs(@RequestParam Map): ResponseEntity<Page<JobResponse>>
    }
    
    class ApplicationController {
        - JobService jobService
        + postApplication(@RequestBody ApplicationRequest): ResponseEntity<ApplicationResponse>
        + getMyApplications(): ResponseEntity<Page<ApplicationResponse>>
        + getApplicationsForMyJobs(): ResponseEntity<Page<ApplicationResponse>>
        + putApplicationStatus(@PathVariable Long, @RequestBody StatusRequest): ResponseEntity<Void>
    }
}

' ========== DEPENDENCIES ==========

AccountRepository ..> Account
JobRepository ..> Job
ApplicationRepository ..> Application
CategoryRepository ..> Category
ActivityLogRepository ..> ActivityLog

AuthService ..> AccountRepository
AdminService ..> AccountRepository
AdminService ..> JobRepository
AdminService ..> CategoryRepository
AdminService ..> ActivityLogRepository
JobService ..> JobRepository
JobService ..> ApplicationRepository
UserService ..> UserRepository
UserService ..> ApplicationRepository

AuthController ..> AuthService
AdminController ..> AdminService
JobController ..> JobService
ApplicationController ..> JobService

' ========== ANNOTATIONS ==========

note top of AuthController
  @RestController
  @RequestMapping("/api/auth")
  @Validated
end note

note top of AdminController
  @RestController
  @RequestMapping("/api/admin")
  @PreAuthorize("hasRole('ADMIN')")
end note

note top of JobController
  @RestController
  @RequestMapping("/api/jobs")
  @PreAuthorize("hasAnyRole('ADMIN', 'EMPLOYER', 'CANDIDATE')")
end note

note top of ApplicationController
  @RestController
  @RequestMapping("/api/applications")
  @PreAuthorize("hasAnyRole('ADMIN', 'EMPLOYER', 'CANDIDATE')")
end note

@enduml
