# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy to .env.production and fill in actual values
# ==========================================

# ---- Database (RDS PostgreSQL) ----
DB_HOST=your-rds-endpoint.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=iting_job_portal
DB_USERNAME=postgres
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD

# ---- JWT Secrets ----
JWT_SECRET=GENERATE_A_NEW_RANDOM_256BIT_HEX_SECRET
JWT_EXPIRATION=86400000
JWT_REFRESH_SECRET=GENERATE_A_NEW_RANDOM_512BIT_HEX_SECRET
JWT_REFRESH_EXPIRATION=604800000

# ---- AWS S3 ----
AWS_ACCESS_KEY=AKIA...
AWS_SECRET_KEY=YOUR_AWS_SECRET
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=datn-jobweb

# ---- Mail (SMTP) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ---- Google OAuth2 ----
GOOGLE_CLIENT_ID=435696030871-xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_SECRET

# ---- AI APIs ----
GEMINI_API_KEY=YOUR_GEMINI_KEY
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- CORS ----
CORS_ORIGINS=https://your-cloudfront-domain.cloudfront.net

# ---- Swagger (disable for prod) ----
SWAGGER_ENABLED=false
